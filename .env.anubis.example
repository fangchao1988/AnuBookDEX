# AnuBookDEX · Anubis 引擎部署密钥模板
# 使用：cp .env.anubis.example .env.anubis 并填入真实值（.env.anubis 已在 .gitignore）

# operator 结算私钥（CONFIG: chain.anubis.metamask-private-key）
# 链上 submitBatch 签名用；该地址需在 Settlement 合约上被 authorizeEngine 授权
ANUBIS_PRIVATE_KEY_METAMASK=0x...

# operator view key（CONFIG: chain.anubis.view-key-private）
# 隐私下单 ECIES 解密（P-256 私钥 hex，32 字节）。留空则隐私模式下单返回 enabled=false
ANUBIS_VIEW_KEY=0x...

# 可选：通用 operator key 回落（metamask key 优先，一般不用填）
# ANUBIS_PRIVATE_KEY=0x...
